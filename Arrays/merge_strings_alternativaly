class Solution
{
public:
    string mergeAlternately(string word1, string word2)
    {

        int n = word1.size();
        int n2 = word2.size();

        int i = 0, j = 0;
        string ans;

        while (i < n && j < n2)
        {
            ans.push_back(word1[i]);
            i++;
            ans.push_back(word2[j]);
            j++;
        }
        while (i < n)
        {
            ans.push_back(word1[i]);
            i++;
        }
        while (j < n2)
        {
            ans.push_back(word2[j]);
            j++;
        }
        return ans;
    }
};