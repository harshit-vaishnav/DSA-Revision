#include <bits/stdc++.h>
using namespace std;
class Solution
{
public:
    long long CalculateHr(vector<int> &nums, int speed, int h)
    {
        int n = nums.size();
        long long Th = 0;
        for (int i = 0; i < n; i++)
        {
            Th = Th + (nums[i] + speed - 1) / speed;
            if (Th > h)
                return Th;
        }
        return Th;
    }
    // orginal Function
    int minEatingSpeed(vector<int> &nums, int h)
    {
        // step-1 Brute Force
        // int MaxE=*max_element(nums.begin(),nums.end());
        // int n=nums.size();
        // if(n>h) return -1;
        // for(int k=1;k<=MaxE;k++)
