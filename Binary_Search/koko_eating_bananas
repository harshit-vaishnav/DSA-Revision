        //       sum+=div;
        //       if(sum>h) break;
        //    }
        //     if(sum<=h) return k;
        // }
        //  return -1;

        //  step-2 Optimal
        int n = nums.size();

        int low = 1, high = *max_element(nums.begin(), nums.end());

        while (low < high)
        {
            int speed = low + (high - low) / 2;

            long long Th = CalculateHr(nums, speed, h);

            if (Th <= h)
            {
                high = speed;
            }
            else
                low = speed + 1;
        }
        return low;
    }
};